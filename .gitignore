const input = document.getElementById('fileInput');
const chooseBtn = document.getElementById('chooseBtn');
const analyseBtn = document.getElementById('analyseBtn');
const saveBtn = document.getElementById('saveBtn');
const resetBtn = document.getElementById('resetBtn');
const dropZone = document.getElementById('dropZone');
const workspace = document.getElementById('workspace');
const apiStatus = document.getElementById('apiStatus');
const canvas = document.getElementById('chartCanvas');
const ctx = canvas.getContext('2d');

let image = null;
let lastAnalysis = null;

chooseBtn.addEventListener('click', (event) => {
  event.preventDefault();
  input.click();
});

input.addEventListener('change', () => {
  const file = input.files && input.files[0];
  if (file) loadImage(file);
});

dropZone.addEventListener('dragover', (event) => event.preventDefault());
dropZone.addEventListener('drop', (event) => {
  event.preventDefault();
  const file = event.dataTransfer && event.dataTransfer.files[0];
  if (file) loadImage(file);
});

resetBtn.addEventListener('click', () => {
  input.value = '';
  analyseBtn.disabled = true;
  workspace.hidden = true;
  image = null;
  lastAnalysis = null;
  ctx.clearRect(0, 0, canvas.width, canvas.height);
});

saveBtn.addEventListener('click', () => {
  if (!lastAnalysis || !canvas.width) return;
  const link = document.createElement('a');
  link.download = 'technical-analysis-annotated.png';
  link.href = canvas.toDataURL('image/png');
  link.click();
});

async function checkApiStatus() {
  try {
    const response = await fetch('/api/health');
    const payload = await response.json();

    if (payload && payload.ok && payload.hasOpenAI) {
      apiStatus.textContent = 'OpenAI API ready';
      apiStatus.className = 'status success';
    } else if (payload && payload.ok) {
      apiStatus.textContent = 'Local analysis mode';
      apiStatus.className = 'status';
    } else {
      apiStatus.textContent = 'API unavailable';
      apiStatus.className = 'status error';
    }
  } catch (error) {
    apiStatus.textContent = 'API unavailable';
    apiStatus.className = 'status error';
  }
}

function loadImage(file) {
  if (!file || !file.type.startsWith('image/')) return;

  const reader = new FileReader();
  reader.onload = () => {
    image = new Image();
    image.onload = () => {
      analyseBtn.disabled = false;
      drawBase();
    };
    image.src = reader.result;
  };
  reader.readAsDataURL(file);
}

function drawBase() {
  const scale = Math.min(1, 1200 / image.width);
  canvas.width = Math.round(image.width * scale);
  canvas.height = Math.round(image.height * scale);
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
  workspace.hidden = false;
}

analyseBtn.addEventListener('click', async () => {
  if (!image) return;

  drawBase();
  const localAnalysis = analysePixels();
  lastAnalysis = localAnalysis;
  render(localAnalysis);
  drawOverlay(localAnalysis);

  try {
    const imageData = canvas.toDataURL('image/png');
    const response = await fetch('/api/analyze', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        imageData,
        prompt: 'Analyze this chart image for technical structure. Return concise fields: direction, bias, confidence, summary, breakout, pullback, continuation, entry, stop, target.',
      }),
    });

    const payload = await response.json();
    if (payload && payload.ok && payload.result) {
      const result = payload.result;
      const summary = result.summary || localAnalysis.summary || 'OpenAI-enhanced chart analysis.';
      const direction = (result.direction || localAnalysis.direction || 'WAIT').toUpperCase();
      const bias = result.bias || localAnalysis.bias || 'Waiting for confirmation';

      const enhanced = {
        ...localAnalysis,
        ...result,
        direction,
        bias,
        summary,
      };

      lastAnalysis = enhanced;
      render(enhanced);
      drawOverlay(enhanced);
    }
  } catch (error) {
    console.warn('OpenAI analysis skipped:', error.message || error);
  }
});

function analysePixels() {
  const w = canvas.width;
  const h = canvas.height;
  const data = ctx.getImageData(0, 0, w, h).data;
  const bins = Math.max(36, Math.min(96, Math.floor(w / 14)));
  const up = new Array(bins).fill(0);
  const down = new Array(bins).fill(0);
  const activity = new Array(bins).fill(0);
  const yActivity = new Array(h).fill(0);
  const priceY = new Array(bins).fill(null);

  for (let y = 0; y < h; y += 2) {
    for (let x = 0; x < w; x += 2) {
      const index = (y * w + x) * 4;
      const r = data[index];
      const g = data[index + 1];
      const b = data[index + 2];
      const v = (r + g + b) / 3;
      const k = Math.min(bins - 1, Math.floor((x / w) * bins));
      const bullish = g > r * 1.1 && g > b * 1.04 && g > 75;
      const bearish = r > g * 1.1 && r > b * 1.04 && r > 75;
      const dark = v < 135;

      if (bullish) {
        up[k]++;
        activity[k]++;
        yActivity[y] += 1;
      }
      if (bearish) {
        down[k]++;
        activity[k]++;
        yActivity[y] += 1;
      }
      if (dark) yActivity[y] += 0.15;
    }
  }

  for (let k = 0; k < bins; k++) {
    let weightedY = 0;
    let weight = 0;
    for (let y = 0; y < h; y += 2) {
      const q = yActivity[y];
      if (q > 0) {
        weightedY += y * q;
        weight += q;
      }
    }
    priceY[k] = weight ? weightedY / weight : h / 2;
  }

  const smooth = (a) => {
    const out = new Array(a.length).fill(0);
    for (let i = 0; i < a.length; i++) {
      let sum = 0;
      let count = 0;
      for (let j = Math.max(0, i - 2); j <= Math.min(a.length - 1, i + 2); j++) {
        sum += a[j];
        count++;
      }
      out[i] = sum / count;
    }
    return out;
  };

  const pu = smooth(up);
  const pd = smooth(down);

  let pocY = h / 2;
  let pocScore = -1;
  for (let y = Math.floor(h * 0.08); y < Math.floor(h * 0.92); y += 2) {
    const score = yActivity[y] + (y > 1 ? yActivity[y - 1] : 0) + (y < h - 1 ? yActivity[y + 1] : 0);
    if (score > pocScore) {
      pocScore = score;
      pocY = y;
    }
  }

  const rangeStart = Math.floor(bins * 0.32);
  const rangeEnd = Math.floor(bins * 0.62);
  let rangeTop = h;
  let rangeBottom = 0;
  for (let k = rangeStart; k <= rangeEnd; k++) {
    const yy = priceY[k];
    if (Number.isFinite(yy)) {
      rangeTop = Math.min(rangeTop, yy);
      rangeBottom = Math.max(rangeBottom, yy);
    }
  }
  if (rangeTop === h) {
    rangeTop = pocY - h * 0.07;
    rangeBottom = pocY + h * 0.07;
  }

  const rangePad = Math.max(10, h * 0.018);
  rangeTop = Math.max(5, rangeTop - rangePad);
  rangeBottom = Math.min(h - 5, rangeBottom + rangePad);

  const recentStart = Math.floor(bins * 0.72);
  const priorStart = Math.floor(bins * 0.52);
  const recentY = priceY.slice(recentStart);
  const priorY = priceY.slice(priorStart, recentStart);
  const avg = (arr) => arr.reduce((sum, val) => sum + val, 0) / Math.max(1, arr.length);
  const recentAvg = avg(recentY);
  const priorAvg = avg(priorY);
  const latestAvg = avg(priceY.slice(Math.floor(bins * 0.88)));
  const midAvg = avg(priceY.slice(Math.floor(bins * 0.68), Math.floor(bins * 0.8)));

  const bullishBreak = latestAvg < rangeTop;
  const bearishBreak = latestAvg > rangeBottom;
  const bullishPull = midAvg <= rangeTop + rangePad * 2 && latestAvg < midAvg;
  const bearishPull = midAvg >= rangeBottom - rangePad * 2 && latestAvg > midAvg;
  const bullishTrend = recentAvg < priorAvg - rangePad * 0.45;
  const bearishTrend = recentAvg > priorAvg + rangePad * 0.45;

  let recentBull = 0;
  let recentBear = 0;
  let rangeBull = 0;
  let rangeBear = 0;

  for (let k = 0; k < bins; k++) {
    if (k >= recentStart) {
      recentBull += pu[k];
      recentBear += pd[k];
    }
    if (k >= rangeStart && k <= rangeEnd) {
      rangeBull += pu[k];
      rangeBear += pd[k];
    }
  }

  const longScore = (bullishBreak ? 3 : 0) + (bullishPull ? 3 : 0) + (bullishTrend ? 2 : 0) + (recentBull > recentBear * 1.05 ? 1 : 0) + (rangeBull >= rangeBear * 0.75 ? 1 : 0);
  const shortScore = (bearishBreak ? 3 : 0) + (bearishPull ? 3 : 0) + (bearishTrend ? 2 : 0) + (recentBear > recentBull * 1.05 ? 1 : 0) + (rangeBear >= rangeBull * 0.75 ? 1 : 0);

  let direction = 'WAIT';
  if (longScore >= 6 && longScore >= shortScore + 2) direction = 'LONG';
  else if (shortScore >= 6 && shortScore >= longScore + 2) direction = 'SHORT';

  const pendingSetup = longScore > shortScore ? 'LONG' : shortScore > longScore ? 'SHORT' : 'BOTH';
  const pendingEntryY = pendingSetup === 'LONG' ? rangeTop : pendingSetup === 'SHORT' ? rangeBottom : pocY;
  const pendingStopY = pendingSetup === 'LONG'
    ? Math.min(h - 12, rangeBottom + Math.max(14, h * 0.025))
    : pendingSetup === 'SHORT'
      ? Math.max(12, rangeTop - Math.max(14, h * 0.025))
      : pocY;
  const pendingTargetY = pendingSetup === 'LONG'
    ? Math.max(12, pendingEntryY - (pendingStopY - pendingEntryY) * 2)
    : pendingSetup === 'SHORT'
      ? Math.min(h - 12, pendingEntryY + (pendingEntryY - pendingStopY) * 2)
      : pocY;

  let breakoutY = pocY;
  let pullbackY = pocY;
  let entryY = pocY;
  let slY = pocY;
  let tpY = pocY;

  if (direction === 'LONG') {
    breakoutY = rangeTop;
    pullbackY = Math.max(rangeTop, Math.min(rangeBottom, midAvg));
    entryY = Math.min(pocY, pullbackY);
    slY = Math.min(h - 12, rangeBottom + Math.max(14, h * 0.025));
    tpY = Math.max(12, entryY - (slY - entryY) * 2);
  } else if (direction === 'SHORT') {
    breakoutY = rangeBottom;
    pullbackY = Math.min(rangeBottom, Math.max(rangeTop, midAvg));
    entryY = Math.max(pocY, pullbackY);
    slY = Math.max(12, rangeTop - Math.max(14, h * 0.025));
    tpY = Math.min(h - 12, entryY + (entryY - slY) * 2);
  }

  const confidence = direction === 'WAIT' ? 0 : Math.min(95, Math.round(58 + Math.abs(longScore - shortScore) * 5));

  return {
    w,
    h,
    pY: pocY,
    rangeTop,
    rangeBottom,
    breakoutY,
    pullbackY,
    entryY,
    slY,
    tpY,
    pendingSetup,
    pendingEntryY,
    pendingStopY,
    pendingTargetY,
    direction,
    confidence,
    longScore,
    shortScore,
    accum: (rangeBottom - rangeTop) > h * 0.025 ? 'Detected' : 'Possible',
    breakout: direction === 'WAIT'
      ? 'Waiting for ' + (pendingSetup === 'BOTH' ? 'a directional breakout' : pendingSetup.toLowerCase() + ' breakout')
      : direction === 'LONG'
        ? 'Bullish breakout'
        : 'Bearish breakout',
    pullback: direction === 'WAIT' ? 'After breakout, wait for pullback toward POC/value' : 'Pullback toward value',
    continuation: direction === 'WAIT' ? 'Then wait for continuation in the setup direction' : direction === 'LONG' ? 'Bullish continuation' : 'Bearish continuation',
    bias: direction === 'WAIT' ? 'Waiting for confirmation' : direction === 'LONG' ? 'Bullish' : 'Bearish',
    summary: direction === 'WAIT'
      ? 'WAIT: ' + (pendingSetup === 'BOTH' ? 'both directions need confirmation' : pendingSetup + ' setup is forming. Wait for the marked breakout/entry, then pullback and continuation.')
      : 'Detected a ' + direction.toLowerCase() + ' structure using accumulation, breakout, pullback and continuation geometry.',
  };
}

function render(analysis) {
  const set = (id, value) => {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  };

  set('accum', analysis.accum || '--');
  set('poc', Math.round((analysis.pY / analysis.h) * 100) + '% chart height');
  set('breakout', analysis.breakout || '--');
  set('pullback', analysis.pullback || '--');
  set('continuation', analysis.continuation || '--');
  set('bias', analysis.bias || '--');

  const directionEl = document.getElementById('direction');
  if (directionEl) {
    directionEl.textContent = (analysis.direction || 'WAIT').toUpperCase();
    directionEl.className = 'direction ' + ((analysis.direction || 'wait').toLowerCase());
  }

  if (analysis.direction === 'WAIT') {
    set('entry', analysis.pendingSetup === 'BOTH' ? 'Wait for LONG or SHORT breakout' : 'Wait for ' + analysis.pendingSetup + ' trigger at marked entry');
  } else {
    set('entry', 'Marked on chart');
  }

  const summaryEl = document.getElementById('summary');
  if (summaryEl) summaryEl.textContent = analysis.summary || 'Waiting for chart analysis.';
}

function drawOverlay(analysis) {
  const w = analysis.w;
  const h = analysis.h;
  ctx.save();

  const isLong = analysis.direction === 'LONG';
  const isShort = analysis.direction === 'SHORT';
  const accent = isLong ? '#79d6a4' : isShort ? '#e59a9a' : '#8ab4ff';

  ctx.lineWidth = 2;
  ctx.setLineDash([8, 6]);
  ctx.strokeStyle = '#8ab4ff';
  ctx.beginPath();
  ctx.moveTo(0, analysis.pY);
  ctx.lineTo(w, analysis.pY);
  ctx.stroke();
  ctx.setLineDash([]);
  ctx.font = '900 13px system-ui';
  ctx.fillStyle = '#8ab4ff';
  ctx.fillText('POC', 12, Math.max(18, analysis.pY - 8));

  ctx.fillStyle = '#8ab4ff18';
  ctx.strokeStyle = '#8ab4ff';
  ctx.lineWidth = 2;
  ctx.strokeRect(w * 0.08, analysis.rangeTop, w * 0.56, analysis.rangeBottom - analysis.rangeTop);
  ctx.font = '800 12px system-ui';
  ctx.fillStyle = '#8ab4ff';
  ctx.fillText('ACCUMULATION / VALUE', w * 0.09, Math.max(18, analysis.rangeTop - 7));

  if (!isLong && !isShort) {
    const pendingColor = analysis.pendingSetup === 'SHORT' ? '#e59a9a' : analysis.pendingSetup === 'LONG' ? '#79d6a4' : '#8ab4ff';
    ctx.fillStyle = pendingColor;
    ctx.font = '900 15px system-ui';
    ctx.fillText(
      analysis.pendingSetup === 'BOTH' ? 'WAIT — WAITING FOR DIRECTION' : 'WAIT — WATCH ' + analysis.pendingSetup + ' SETUP',
      w * 0.08,
      Math.min(h - 16, analysis.rangeBottom + 28)
    );

    if (analysis.pendingSetup !== 'BOTH') {
      drawLevel(analysis.pendingEntryY, 'ENTRY TRIGGER', pendingColor, true);
      drawLevel(analysis.pendingStopY, 'INVALIDATION', pendingColor, true);
      drawLevel(analysis.pendingTargetY, 'TARGET', pendingColor, true);
      ctx.font = '800 12px system-ui';
      ctx.fillStyle = pendingColor;
      ctx.fillText(
        analysis.pendingSetup === 'LONG' ? 'LONG: breakout above value → pullback → continuation' : 'SHORT: breakout below value → pullback → continuation',
        w * 0.08,
        Math.min(h - 34, analysis.rangeBottom + 46)
      );
    } else {
      drawLevel(analysis.pY, 'WAIT / POC', pendingColor, true);
    }

    ctx.restore();
    return;
  }

  const bx = w * 0.08;
  const bw = w * 0.58;
  ctx.fillStyle = accent + '22';
  ctx.strokeStyle = accent;
  ctx.lineWidth = 2;
  ctx.fillRect(bx, analysis.rangeTop, bw, analysis.rangeBottom - analysis.rangeTop);
  ctx.strokeRect(bx, analysis.rangeTop, bw, analysis.rangeBottom - analysis.rangeTop);

  ctx.font = '900 16px system-ui';
  ctx.fillStyle = accent;
  ctx.fillText(isLong ? 'LONG SETUP' : 'SHORT SETUP', bx + 10, Math.max(22, analysis.rangeTop + 22));

  drawLevel(analysis.tpY, 'TP', accent, true);
  drawLevel(analysis.entryY, 'ENTRY', accent, false);
  drawLevel(analysis.slY, 'SL', accent, true);
  drawLevel(analysis.breakoutY, 'BREAKOUT', accent, true);

  ctx.font = '900 12px system-ui';
  ctx.fillStyle = accent;
  ctx.fillText('PULLBACK', w * 0.09, Math.max(18, Math.min(h - 18, analysis.pullbackY - 8)));

  ctx.restore();

  function drawLevel(y, label, color, dash) {
    y = Math.max(18, Math.min(h - 18, y));
    ctx.save();
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = 3;
    ctx.setLineDash(dash ? [10, 7] : []);
    ctx.beginPath();
    ctx.moveTo(w * 0.04, y);
    ctx.lineTo(w * 0.96, y);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.font = '900 13px system-ui';
    const tw = Math.max(54, ctx.measureText(label).width + 24);
    const lx = w * 0.72;
    ctx.fillStyle = color;
    ctx.fillRect(lx, y - 13, tw, 26);
    ctx.fillStyle = '#07100d';
    ctx.fillText(label, lx + 12, y + 5);
    ctx.restore();
  }
}

checkApiStatus();

window.addEventListener('DOMContentLoaded', () => {
  checkApiStatus();
});

if (canvas) {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
}


























































































































































































































































































































































































